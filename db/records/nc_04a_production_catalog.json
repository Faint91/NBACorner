{
  "views": [
    {
      "viewname": "bracket_view",
      "viewowner": "postgres",
      "definition": " SELECT m.id,\n    m.bracket_id,\n    m.round,\n    m.slot,\n    m.team_a,\n    m.team_b,\n    m.team_a_locked,\n    m.team_b_locked,\n    m.predicted_winner,\n    m.predicted_winner_games,\n    m.next_match_id,\n    m.next_slot,\n    m.created_at,\n    m.updated_at,\n    b.user_id\n   FROM (matches m\n     JOIN brackets b ON ((b.id = m.bracket_id)));",
      "schemaname": "public"
    }
  ],
